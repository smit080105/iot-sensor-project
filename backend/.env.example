# NOTE: Render's free-tier Postgres expires ~30 days after creation.
# If DATABASE_URL suddenly fails, check Render dashboard for an
# "expired" database and recreate it (see project notes).
PORT=4000
PGHOST=postgres
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# MQTT broker. Production should use a private broker with TLS and mTLS.
# MQTT_URL is required; the backend will not silently select a public broker.
# For the bundled Docker Mosquitto:
MQTT_URL=mqtts://mosquitto:8883
MQTT_BROKER_MODE=private
MQTT_AUTH_MODE=mtls
MQTT_CA_CERT_PATH=../certs/ca.crt
MQTT_CLIENT_CERT_PATH=../certs/backend/backend-service.crt
MQTT_CLIENT_KEY_PATH=../certs/backend/backend-service.key
# For a private managed broker using TLS username/password instead, choose
# MQTT_AUTH_MODE=password and set MQTT_USERNAME / MQTT_PASSWORD in your secret store.
# Never commit real credentials.

# Non-production test only: use MQTT_URL=mqtts://broker.emqx.io:8883,
# MQTT_BROKER_MODE=public-test, MQTT_AUTH_MODE=none. Public topics are shared.

# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Must match exactly what the device publishes in remo_reg.
PAIRING_TOKEN=your_long_random_pairing_token

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in the x-api-key header on every /api/* request except /api/health.
# Must match VITE_API_KEY in frontend/.env.
API_KEY=your_long_random_api_key

# Exact origin the frontend is served from (scheme + host + port, no trailing slash).
ALLOWED_ORIGIN=http://localhost:5173
